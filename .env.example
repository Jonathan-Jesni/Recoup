# Razorpay test mode (dashboard -> Settings -> API Keys, test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Fireworks AI (https://fireworks.ai -> API keys)
FIREWORKS_API_KEY=fw_xxxxxxxxxxxx

# Model selected by measurement, not assumption: 4 candidates x 6 events spanning
# every failure type. glm-5p2 was the only one that combined 6/6 schema validity
# with the highest agreement against config/recovery_model.json. Note that
# llama-v3p3-70b is NO LONGER serverless on Fireworks -- it 404s without a
# dedicated deployment.
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p2

# Cost model. Fireworks prices input and output separately (glm-5p2: $1.40 / $4.40
# per 1M), so these are kept apart rather than blended -- run.json reports
# inference_cost_per_100_inr_recovered and the rates behind it.
FIREWORKS_USD_PER_M_INPUT=1.40
FIREWORKS_USD_PER_M_OUTPUT=4.40
USD_INR=88

# Reasoning models spend tokens thinking before emitting JSON; 600 truncated them.
FIREWORKS_MAX_TOKENS=4000
